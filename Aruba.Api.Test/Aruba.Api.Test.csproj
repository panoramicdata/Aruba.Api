<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- CS0436: Refit 12 transitively runs the ReactiveUI.Primitives source generator, which emits
         an internal marker attribute into both Aruba.Api and this test assembly; InternalsVisibleTo
         then makes them collide. The attribute is inert, so the duplication is harmless. -->
    <NoWarn>$(NoWarn);CS1591;CS0436</NoWarn>
    <!-- Enables `dotnet user-secrets` for read-only integration test credentials.
         See usersecrets.example.json for the expected shape. -->
    <UserSecretsId>aruba-api-tests-b8e7a3c2-1f4d-4e6a-9c5b-2a3d4e5f6071</UserSecretsId>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Aruba.Api\Aruba.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Template only: copy the values into user-secrets (dotnet user-secrets set ...)
         or supply them as environment variables. Never put real secrets in this file. -->
    <None Include="usersecrets.example.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
