<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralResourcesLanguage>en</NeutralResourcesLanguage>
    <!-- NuGet package metadata -->
    <PackageId>Aruba.Api</PackageId>
    <Owners>Panoramic Data Limited</Owners>
    <PackageProjectUrl>https://github.com/panoramicdata/Aruba.Api</PackageProjectUrl>
    <RepositoryUrl>https://github.com/panoramicdata/Aruba.Api</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageIcon>Logo.png</PackageIcon>
    <Description>.NET 10 API client for HPE Aruba Networking Central (New Central): monitoring, notifications, reporting, services and troubleshooting. OAuth 2.0 client-credentials auth with automatic token refresh, retry/back-off and read-only safety.</Description>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageTags>Aruba;HPE;Central;ArubaCentral;Networking;WiFi;API;Client;Refit;PanoramicData</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Refit" />
    <PackageReference Include="SecurityCodeScan.VS2019" PrivateAssets="all" />
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Logo.png" Pack="true" PackagePath="" />
    <None Include="..\README.md" Link="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Aruba.Api.Test" />
  </ItemGroup>
</Project>